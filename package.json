{
  "name": "dev-agent-skills",
  "version": "2.1.0",
  "private": true,
  "description": "Reusable instruction files for coding agents, with a router, eval harness, MCP server and Android pack",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/devskills.mjs check",
    "test": "node --test tests/*.test.mjs",
    "new": "node scripts/devskills.mjs new",
    "lock": "node scripts/devskills.mjs lock",
    "lock:check": "node scripts/devskills.mjs lock:check",
    "eval": "node scripts/eval.mjs",
    "graph": "node scripts/graph.mjs",
    "site:build": "node scripts/build-site.mjs",
    "mcp": "node scripts/mcp-server.mjs",
    "install": "node scripts/install.mjs",
    "verify": "npm run check && npm test && npm run lock:check && npm run eval && npm run graph && npm run site:build"
  },
  "license": "MIT"
}
